# /etc/cgm/vm.env — sandbox VM 脚本使用的环境变量
# host VM 的内网 IP（唯一允许连接 sandboxd 7443 / ssh 的来源）
HOST_VM_IP=10.10.0.2
# IAP TCP forwarding 来源段（break-glass SSH）
IAP_RANGE=35.235.240.0/20
SANDBOXD_PORT=7443
# homes 所在 PD 挂载点与每个 home 的配额
HOMES_MOUNT=/var/lib/cgm
HOME_QUOTA_BLOCKS_KB=5242880
HOME_QUOTA_INODES=200000
